// Hearth on Cloudflare Workers. See docs/cloud.md.
// `npx wrangler deploy` creates the D1 database the first time.
// Set the household password with: npx wrangler secret put HEARTH_PASSWORD
{
  "name": "hearth",
  "main": "server/cloudflare.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hearth" }
  ],
  "observability": { "enabled": true }
}
